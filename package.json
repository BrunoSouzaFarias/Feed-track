{
  "name": "feed-track",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-feed-track \"vitest run --config vitest.rules.config.ts\"",
    "ci": "npm run typecheck && npm run lint && npm test && npm run functions:typecheck && npm run build",
    "rules:strict": "node scripts/gen-strict-rules.mjs",
    "functions:typecheck": "npm --prefix functions run typecheck",
    "test:functions": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions --project demo-feed-track \"vitest run --config vitest.functions.config.ts\"",
    "setup:console": "node scripts/firebase-console-setup.mjs",
    "backfill:team": "node scripts/backfill-team.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.14.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lenis": "^1.3.23",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.8",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.36.0",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
