# Feed-Track — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais do Firebase
# Nunca commite o arquivo .env com valores reais

VITE_FIREBASE_API_KEY=sua-api-key-aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Para rodar em modo mock (sem Firebase real), deixe as variáveis acima vazias
# ou preencha com "mock" / "dummy" — o app detecta automaticamente e usa localStorage
